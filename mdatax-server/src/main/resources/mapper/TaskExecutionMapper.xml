<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mogu.data.integration.mapper.TaskExecutionMapper">

    <select id="selectByExecutionId" resultType="com.mogu.data.integration.entity.TaskExecution">
        SELECT *
        FROM task_execution
        WHERE execution_id = #{executionId}
    </select>

    <select id="selectAvgDurationMsByTaskId" resultType="java.lang.Long">
        SELECT AVG(duration_ms)
        FROM task_execution
        WHERE task_id = #{taskId}
          AND status = 'SUCCESS'
          AND deleted = 0
    </select>

    <select id="countByStatus" resultType="com.mogu.data.integration.mapper.TaskExecutionMapper$StatusCount">
        SELECT status, COUNT(*) AS count
        FROM task_execution
        WHERE deleted = 0
        <if test="startTime != null">
            AND start_time &gt;= #{startTime}
        </if>
        <if test="endTime != null">
            AND start_time &lt;= #{endTime}
        </if>
        GROUP BY status
    </select>

</mapper>
