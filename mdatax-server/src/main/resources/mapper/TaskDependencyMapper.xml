<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mogu.data.integration.mapper.TaskDependencyMapper">

    <select id="selectByDownstreamTaskId" resultType="com.mogu.data.integration.entity.TaskDependency">
        SELECT *
        FROM task_dependency
        WHERE downstream_task_id = #{downstreamTaskId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByUpstreamTaskId" resultType="com.mogu.data.integration.entity.TaskDependency">
        SELECT *
        FROM task_dependency
        WHERE upstream_task_id = #{upstreamTaskId}
        ORDER BY create_time DESC
    </select>

</mapper>
